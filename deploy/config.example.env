# MyTimeLogger private deployment target template.
# Copy to deploy/config.local.env and keep that file outside Git/Docker context.
# Select development/testing/production with the script -Environment argument.
# App accounts and server URLs are entered on the login page; provider secrets
# are imported per authenticated user and never belong in this file.

MTL_SERVER_HOST=example.com
MTL_SERVER_PORT=22
MTL_SERVER_USER=deploy-user
MTL_REMOTE_DIR=/opt/mytimelogger
MTL_APP_PORT=8000
