{
  "name": "mytimelogger-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "icons:import-atm": "node scripts/import-atm-icons.mjs",
    "icons:check-atm": "node scripts/check-atm-icons.mjs",
    "icons:check-atm:private": "set MTL_RELEASE_PROFILE=private&& node scripts/check-atm-icons.mjs",
    "typecheck": "tsc --noEmit",
    "build:android-web": "node scripts/build-android-web.mjs",
    "preflight:android-release": "node scripts/preflight-android-release.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@capacitor/android": "8.4.1",
    "@capacitor/app": "8.1.0",
    "@capacitor/browser": "8.0.3",
    "@capacitor/core": "8.4.1",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/local-notifications": "8.2.0",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/status-bar": "8.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "mind-elixir": "^5.15.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "playwright": "^1.60.0"
  }
}
