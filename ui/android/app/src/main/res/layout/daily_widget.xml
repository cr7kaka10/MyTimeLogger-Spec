<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/timer_widget_background"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/daily_title" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center_vertical" android:text="今天" android:textSize="18sp"
            android:textStyle="bold" android:textColor="#FFFFFF" android:contentDescription="打开今日清单" />
        <TextView android:id="@+id/daily_refresh" android:layout_width="44dp" android:layout_height="44dp"
            android:gravity="center" android:text="↻" android:textSize="22sp" android:textColor="#9CA3FF"
            android:contentDescription="刷新今日清单" />
    </LinearLayout>
    <ListView android:id="@+id/daily_list" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="0dp"
        android:scrollbars="none" />
</LinearLayout>
