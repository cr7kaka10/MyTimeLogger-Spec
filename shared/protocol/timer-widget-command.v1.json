{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mytimelogger.local/timer-widget-command.v1.json",
  "title": "MyTimeLogger Android timer widget command v1",
  "type": "object",
  "required": ["action", "commandId", "categoryId", "eventEpochMs"],
  "additionalProperties": false,
  "properties": {
    "action": { "enum": ["start", "switch", "stop"] },
    "commandId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,64}$"
    },
    "categoryId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "eventEpochMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
